# Gitea Pages 配置
#
# 此文件中的变量统一以 PAGES_ 开头，避免与同目录其他 Compose 项目冲突。
# Compose 会将它们映射为容器内部所需的配置；请勿改用无前缀的旧变量名。

# 完整的 Pages 域名，例如 pages.example.com。
# 用户站点地址为：https://用户名.<此域名>/
PAGES_DOMAIN=pages.yourdomain.com

# 运行环境。生产环境请保持 production；仅本地开发可使用 development。
PAGES_APP_ENV=production

# Nginx 对外暴露的宿主机端口。
PAGES_HTTP_PORT=80

# 宿主机上已发布站点文件的目录。可使用相对 Compose 文件的路径，例如
# ./pages/webroot；从旧版本升级时可直接保留该路径。
PAGES_DATA_DIR=./pages/webroot

# 容器运行用户的 UID/GID。密钥文件和 PAGES_DATA_DIR 必须允许该用户读取/写入。
PAGES_UID=1000
PAGES_GID=1000

# 必需的密钥文件。密钥值不要写入本文件、Compose 文件、镜像或日志。
# 首次部署前执行：
#   install -d -m 700 secrets
#   openssl rand -base64 48 > secrets/gitea_pages_session_secret
#   openssl rand 32 > secrets/gitea_pages_token_encryption_key
#   printf '%s' '从 Gitea OAuth 应用复制的 Client Secret' > secrets/gitea_pages_oauth_client_secret
#   chmod 600 secrets/gitea_pages_*
#
# token_encryption_key 是恰好 32 字节的二进制数据；不要用文本编辑器修改或追加换行。
# Docker Compose 会保留宿主机文件的属主和权限。若 PAGES_UID/PAGES_GID 不是当前
# 用户，请将这些密钥文件 chown 为对应 UID:GID，再保持权限为 0600。
PAGES_SESSION_SECRET_HOST_FILE=./secrets/gitea_pages_session_secret
PAGES_TOKEN_ENCRYPTION_KEY_HOST_FILE=./secrets/gitea_pages_token_encryption_key
PAGES_OAUTH_CLIENT_SECRET_HOST_FILE=./secrets/gitea_pages_oauth_client_secret

# Gitea API 地址。
PAGES_GITEA_API_URL=https://gitea.example.com

# 可选：用户浏览器和 Git 克隆实际访问的 Gitea 地址。部署始终从此地址克隆；
# 与 API 地址相同时无需设置。
# PAGES_GITEA_PUBLIC_URL=https://gitea.example.com

# 在 Gitea「设置 -> 应用 -> OAuth2 应用」中创建机密客户端后取得的 Client ID。
# 回调地址填写：https://<PAGES_DOMAIN>/oauth/callback
PAGES_OAUTH_CLIENT_ID=replace-with-pages-oauth-client-id

# 以下均为可选的资源与部署限制。
PAGES_MAX_SITE_SIZE_MB=100
PAGES_MAX_REPOSITORY_SIZE_MB=1024
PAGES_MAX_CONCURRENT_DEPLOYS=4
PAGES_CLONE_TIMEOUT=1m
PAGES_ACQUIRE_TIMEOUT=30s

# 保持 true 可继续支持组织创建一个 webhook 后覆盖其下属仓库。
PAGES_ENABLE_ORGANIZATION_HOOKS=true
